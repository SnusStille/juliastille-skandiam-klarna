# ---------------------------------------------------------------
# Julia Stille — Mäklarplattform
# Kopiera denna fil till .env.local och fyll i dina värden.
# ---------------------------------------------------------------

# --- Inloggning -------------------------------------------------
# Lösenordet Julia loggar in med.
APP_PASSWORD=Loppan123
# Namnet som visas i appen.
NEXT_PUBLIC_APP_USER=Julia Stille
# Hemlig nyckel som signerar sessionskakan.
# Generera en egen: openssl rand -base64 48
AUTH_SECRET=byt-ut-mig-till-en-lang-slumpmassig-strang-minst-32-tecken

# --- Supabase ---------------------------------------------------
# Hittas i Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role-nyckeln. Endast server-side. Dela ALDRIG publikt.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (Anthropic) ----------------------------------------
# Hittas på https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
